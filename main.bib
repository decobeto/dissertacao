@article{Malik2024,
  abstract  = {Digital Twin technology is rapidly advancing, offering a virtual representation that models and connects complex physical systems for diverse purposes like simulation, monitoring, maintenance, and optimization. In contrast to traditional approaches limited to simulating specific physical processes, simulations within a digital twin comprise polymorphic environments that accurately depict large-scale systems. These digital twins remain connected to their physical counterparts through real-time data and feedback loops. While the benefits of implementing digital twins are numerous, the resources, effort, and investment required can vary for each use case. Manufacturers often must assess the return on investment (ROI) before committing to these initiatives. However, digital twins' intricate, multidimensional nature poses challenges in accurately evaluating their ROIs. This research assesses the economic impact of developing digital twins for manufacturing systems and presents a practical framework for assessing ROI. This systematic approach can help stakeholders enhance the financial viability of digital twin projects.},
  author    = {Ali Ahmad Malik},
  doi       = {10.1109/WSC63780.2024.10838771},
  isbn      = {9798331534202},
  issn      = {08917736},
  journal   = {Proceedings - Winter Simulation Conference},
  pages     = {1623-1633},
  publisher = {Institute of Electrical and Electronics Engineers Inc.},
  title     = {THE ECONOMIC IMPACT OF DIGITAL TWIN TECHNOLOGY ON MANUFACTURING SYSTEMS},
  url       = {https://ieeexplore.ieee.org/document/10838771},
  year      = {2024}
}
@article{Xu2025,
  abstract  = {In the midst of the swift advance of informatization, digital twin technology has garnered escalating attention. Synthesizing the current research landscape and cutting-edge developments in digital twin technology is crucial for propelling its scholarly exploration. This study employs a methodological fusion of scientometrics and knowledge graph analysis to comprehensively encapsulate the research accomplishments of digital twin technology across extant scientific domains. It visually dissects 4, 954 articles pertaining to digital twins within the Web of Science core dataset, spanning the decade from 2014 to 2024. Leveraging keyword cluster analysis, the research identifies the focal areas that have captivated researchers in recent years, along with the prevailing research trends. Building upon this foundation, the paper delineates the pivotal technologies underpinning digital twins. Ultimately, the study offers strategic recommendations for the evolutionary trajectory of digital twin technology, aspiring to furnish a scientific touchstone for global digital twin research endeavors.},
  author    = {Qianwen Xu and Jingchao Wang and Wei Gao and Shuangyin Ren and Zhongbo Li},
  doi       = {10.1145/3708036.3708159;CSUBTYPE:STRING:CONFERENCE},
  isbn      = {9798400709999},
  journal   = {Proceedings of 2024 5th International Conference on Computer Science and Management Technology, ICCSMT 2024},
  keywords  = {Visual analytics,core technologies,current landscape,digital twin,future outlook},
  month     = {1},
