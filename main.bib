@article{Jiang2024,
  abstract  = {Service-oriented architecture (SOA) serves as a foundational technology for complex IT systems, such as e-commerce platforms, banking solutions, public-sector applications, and gaming systems. As these systems become increasingly intricate, the need for models that enable software engineers to simulate component interactions early in the software lifecycle becomes crucial. This approach helps identify potential issues during the design phase. The goal of this research is to apply digital twin model principles to simulate component transactions, message exchanges, and ultimately evaluate whether a given design meets the goals and requirements of stakeholders. In this paper, we outline ongoing work towards a prototype framework that uses sequence diagrams and activity diagrams to build digital twin models of service-oriented systems. The framework aims to ensure that any design changes are reflected in the digital twin model early in the software lifecycle, potentially uncovering non-compliant or unintended interactions.},
  author    = {Hao Jiang and Kostas Kontogiannis},
  doi       = {10.1109/CASCON62161.2024.10837820},
  isbn      = {9798331504830},
  journal   = {CASCON 2024 Proceedings - 34th Annual International Conference on Collaborative Advances in Software and Computing},
  keywords  = {Compliance,Digital Twin Models,Model Checking,Service-Oriented Systems},
  publisher = {Institute of Electrical and Electronics Engineers Inc.},
  title     = {Towards the Compilation of Digital Twin Models for Service-Oriented Systems},
  url       = {https://ieeexplore.ieee.org/document/10837820},
  year      = {2024}
}
@article{Baek2024,
  abstract  = {This paper considers an implementation methodology for large-scale digital twin system. In our research, federated digital twin implementation methodology is proposed to build the large-scale digital twin system. In the proposed methodology, multiple single digital twin system can be connected and the output data of the multiple digital twin systems is federated. Typically, a single digital twin system is developed to digitally mimic a single physical object, system, or single process. Therefore, in the proposed methodology, the large-scale digital twin can be implemented based on federation of multiple single digital twin systems. To federate the multiple single digital twin systems, single digital twin management, validation and federation techniques are required. Therefore, proposed methodology suggests the architecture and functions of the digital twin federation system.},
  author    = {Myung Sun Baek and Euisuk Jung and Young Soo Park and Yong Tae Lee},
  doi       = {10.1109/BMSB62888.2024.10608284},
  isbn      = {9798350364262},
  issn      = {21555052},
  journal   = {IEEE International Symposium on Broadband Multimedia Systems and Broadcasting, BMSB},
  keywords  = {Digital twin,federated digital twin,federation},
  publisher = {IEEE Computer Society},
  title     = {Federated Digital Twin Implementation Methodology to Build a Large-Scale Digital Twin System},
  url       = {https://ieeexplore.ieee.org/document/10608284},
  year      = {2024}
}
@article{Pereira2024,
  abstract  = {Digital twin (DT) systems encompass virtual counterparts of physical entities that enable advanced monitoring, simulation, and decision-making processes. Despite their transformative potential, DT systems face significant challenges due to the heterogeneity of technologies and data and the complexity of maintaining synchronized interactions between physical and virtual elements. A middleware solution, with its capability ofoffering standardized development interfaces and runtime services, can abstract these complexities and promote interoperability among diverse components of a DT system. This paper addresses these concerns by proposing MidDiTS, a middleware designed to support the development and operation of DT systems. MidDiTS aims to meet essential requirements for DT systems by providing services for storing DT models, managing DT instances, maintaining causal connections between physical and virtual entities, and integrating with third-party applications. This paper focuses on demonstrating how middleware can facilitate the development of DT systems via a proof of concept involving a DT-powered smart house.},
  author    = {Lucas Silva Pereira and Andre Almeida and Flavia C. Delicato and Everton Cavalcante and Thais Batista and Rebeca Motta and Marco Vieira},
  doi       = {10.1109/SWC62898.2024.00319},
  isbn      = {9798331520861},
  journal   = {Proceedings - 2024 IEEE Smart World Congress, SWC 2024 - 2024 IEEE Ubiquitous Intelligence and Computing, Autonomous and Trusted Computing, Digital Twin, Metaverse, Privacy Computing and Data Security, Scalable Computing and Communications},
  keywords  = {digital twins,middleware,system development},
  pages     = {2081-2088},
  publisher = {Institute of Electrical and Electronics Engineers Inc.},
  title     = {Leveraging Middleware to Support Digital Twin System Development},
  url       = {https://ieeexplore.ieee.org/document/10924932},
  year      = {2024}
}
@article{Zhu2021,
  abstract  = {With the advent of the digital age, digital twin as a new potential technology has received much attention from both academia and industry increasingly. Digital twin technology paves a way for achieving cost-efficient trial and performance-optimal management, through creating a virtual representation of physical network digitally to simulate and predict. In this paper, we propose a novel network paradigm, called digital twin network (DTN) architecture for the future network, which consists of Physical Network, Data Lake, Digital Twin Layer and Network Application Layer. A Sketch acquisition algorithm is introduced to meet the demand of large-scale real-time data collection in Data Lake. A digital twin network construction method based on knowledge graph is developed, which can represent entity attribute and various topologies according to physical network. Finally, the proposed DTN is introduced to realize fault self-healing in the future network, and the feasibility and novelty is proved.},
  author    = {Yanhong Zhu and Danyang Chen and Cheng Zhou and Lu Lu and Xiaodong Duan},
  doi       = {10.1109/DTPI52967.2021.9540177},
  isbn      = {9781665433372},
  journal   = {Proceedings 2021 IEEE 1st International Conference on Digital Twins and Parallel Intelligence, DTPI 2021},
  keywords  = {Artificial intelligence,Digital twin network,Knowledge graph},
  month     = {7},
  pages     = {362-365},
  publisher = {Institute of Electrical and Electronics Engineers Inc.},
  title     = {A knowledge graph based construction method for Digital Twin Network},
  url       = {https://ieeexplore.ieee.org/document/9540177},
  year      = {2021}
}
@article{Shao2019,
  abstract  = {The purpose of this panel is to discuss the state of the art in digital twin for manufacturing research and practice from the perspective of the simulation community. The panelists come from the US, Europe, and Asia representing academia, industry, and government. This paper begins with a short introduction to digital twins and then each panelist provides preliminary thoughts on concept, definitions, challenges, implementations, relevant standard activities, and future directions. Two panelists also report their digital twin projects and lessons learned. The panelists may have different viewpoints and may not totally agree with each other on some of the arguments, but the intention of the panel is not to unify researchers' thinking, but to list the research questions, initiate a deeper discussion, and try to help researchers in the simulation community with their future study topics on digital twins for manufacturing.},
  author    = {Guodong Shao and Sanjay Jain and Christoph Laroque and Loo Hay Lee and Peter Lendermann and Oliver Rose},
